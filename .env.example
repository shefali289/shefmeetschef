# Copy this file to .env.local and fill in the values. Never commit .env.local.
# Leave everything empty to preview the site with sample recipes.

# Supabase (Project settings > API). Safe for the browser: RLS protects the data.
# Also add https://<site>/auth/callback** (and http://localhost:3000/auth/callback**) to
# Authentication > URL Configuration > Redirect URLs, or sign-in will fail.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Never prefix these with NEXT_PUBLIC_.
GEMINI_API_KEY=
INSTAGRAM_ACCESS_TOKEN=
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=

# Public site address, used for links and SEO.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
